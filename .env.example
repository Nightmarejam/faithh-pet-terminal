### FAITHH Backend Environment (template)
### Copy to .env and fill in values. Do not commit secrets.

# WSL2 / multi-GPU: expose RTX 3090 (1080 Ti is usually GPU 0). Requires Windows .wslconfig
# with gpus=all and wsl --shutdown. See docs/guides/WSL2_MULTI_GPU.md
CUDA_VISIBLE_DEVICES=1
# Strict pin after .env load: force this Python process (and subprocesses that copy env) to
# see only one physical GPU. Ollama must be started with the SAME visibility for inference.
FAITHH_STRICT_LLM_GPU=1
# Physical PCI index passed to CUDA_VISIBLE_DEVICES when strict (default 1 = second GPU / 3090).
FAITHH_CUDA_PHYSICAL_DEVICE=1

# Backend bind
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5557
BACKEND_DEBUG=0

# LLM endpoints
OLLAMA_HOST=http://127.0.0.1:11434
# Optional: restart_backend.sh Step 4b — OLLAMA_WARMUP=1 primes default model (see OLLAMA_WARMUP_MODEL)
# OLLAMA_WARMUP=0
# OLLAMA_WARMUP_MODEL=qwen25-faithh-v3:latest
OLLAMA_EMBED_URL=http://127.0.0.1:11435

# ChromaDB (Gen8 / servicebox — canonical LAN default below; override with Tailscale if needed)
# Backend and maintenance scripts read CHROMA_HOST / CHROMA_PORT (not localhost unless Chroma is local).
# Optional legacy aliases: CHROMADB_HOST, CHROMADB_PORT (used if CHROMA_HOST is unset).
#
# Storage tiering (WSL): when CHROMA_PERSIST_PATH is set, scripts/system_pulse.py uses a local
# PersistentClient at that path (e.g. external D: via /mnt/d). CHROMA_HOST is then ignored for pulse.
CHROMA_PERSIST_PATH=/mnt/d/ai_storage/chroma_db
RAW_DATA_STAGING=/mnt/d/ai_storage/staging
CHROMA_HOST=http://192.158.1.243:8000
CHROMA_PORT=8000
CHROMA_COLLECTION=documents_768

# Chroma maintenance / census paging (default in code is often 10000). Use 2000 while Cursor
# is open to reduce memory + 9P pressure; raise to 5000 for standalone tmux runs.
# CHROMA_MAINT_BATCH_SIZE=2000
# CHROMA_MAINT_REQUEST_TIMEOUT_S=120

# Session metrics collection (operational telemetry only — not used for RAG retrieval)
CHROMA_METRICS_COLLECTION=faithh_session_metrics
# Stall threshold for session metrics (ms, default 30000)
FAITHH_STALL_THRESHOLD_MS=30000
# Session accumulator max entries before LRU eviction (in-memory per-turn stats)
FAITHH_SESSION_ACCUMULATOR_MAX=500

# RAG relevance (Chroma cosine distance; lower is better). Above threshold → low_confidence in registry/UI.
# Calibrate with: python scripts/sample_rag_distances.py (see docs/architecture/ECOSYSTEM_METRICS.md).
RAG_MAX_DISTANCE_CONFIDENT=0.55
# Seconds to treat the last RAG distance sample as fresh for workspace_registry + /api/chat rag_relevance.
RAG_SIGNAL_STALE_SECONDS=900

# CORS
CORS_ORIGINS=http://localhost:5557,http://127.0.0.1:5557

# Timeouts (seconds)
REQUEST_TIMEOUT_S=60
GROQ_TIMEOUT_S=120
# Ollama /api/generate HTTP read timeout (cold model load from disk can exceed 120s; aligns with configs/model_config.yaml timeout_s)
OLLAMA_TIMEOUT_S=300
# Ollama output token ceiling for /api/generate (min with YAML provider max_tokens); stops runaway generation
OLLAMA_NUM_PREDICT_CAP=1200
# Optional: pipe-separated stop strings (use \n in value for newline). Defaults break === / [CTX: echo loops.
# OLLAMA_STOP=
OLLAMA_STATUS_TIMEOUT_S=2

# Limits
MAX_MESSAGE_LENGTH=4000
MAX_CONTENT_LENGTH=16777216

# RAG processor tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# API keys (set your real values in .env)
GROQ_API_KEY=
# Claude (Messages API): https://console.anthropic.com/ — no quotes; single line (trailing space causes 401)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Ollama KV cache (q8_0 / q4_0 / f16) — NOT read from this file by Ollama.
# Set OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 on the Ollama *server*
# process (systemd drop-in, Windows env, or shell before `ollama serve`). See:
#   docs/guides/OLLAMA_KV_ENV.md

# Dev-only features: POST /api/metrics/flush-session (also allowed from 127.0.0.1 without this).
# FAITHH_DEV_MODE=false

# Conversation session timeout for cleanup + session metrics close (seconds, default 3600).
# FAITHH_SESSION_TIMEOUT_SECONDS=3600

# Local-first calibration: when 1, /api/chat skips cloud providers and uses Ollama only.
# restart_backend.sh exports FAITHH_FORCE_LOCAL=1 after sourcing .env; override in .env if needed.
# FAITHH_FORCE_LOCAL=0

# Ollama model slots (optional overrides)
# DEFAULT_MODEL / OLLAMA_DEFAULT_MODEL are read by faithh_professional_backend_fixed.py
# Should match config.yaml ai.default_model for consistent local-first testing.
OLLAMA_GROUNDED_MODEL=qwen25-grounded-gen5-delta:latest
OLLAMA_REASONING_MODEL=deepseek-r1:32b
OLLAMA_COMPLEX_MODEL=deepseek-r1:32b
