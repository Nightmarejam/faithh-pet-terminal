{
  "name": "faithh-vscode",
  "displayName": "FAITHH - AI Companion",
  "description": "FAITHH NetNavi AI companion for VS Code — chat, ML chips, RAG search, and project intelligence",
  "version": "0.1.0",
  "publisher": "faithh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "faithh.openChat",
        "title": "FAITHH: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "faithh.newChat",
        "title": "FAITHH: New Chat"
      },
      {
        "command": "faithh.askAboutFile",
        "title": "FAITHH: Ask About This File"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "faithh-sidebar",
          "title": "FAITHH",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "faithh-sidebar": [
        {
          "type": "webview",
          "id": "faithh.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "configuration": {
      "title": "FAITHH",
      "properties": {
        "faithh.backendUrl": {
          "type": "string",
          "default": "http://localhost:5557",
          "description": "URL of the FAITHH Flask backend"
        },
        "faithh.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model for chat (leave empty to use backend default)"
        },
        "faithh.sendFileContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically send current file context with messages"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "faithh.askAboutFile",
          "group": "faithh"
        }
      ]
    },
    "keybindings": [
      {
        "command": "faithh.openChat",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
