{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunBookSeedDraft",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "query",
    "seed_id",
    "title",
    "intent",
    "tags",
    "prerequisites",
    "suggested_steps",
    "verification_checks",
    "source_evidence",
    "runbook_frontmatter_suggestion"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "seed_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "verification_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "collection",
          "document_id",
          "score",
          "excerpt",
          "metadata"
        ],
        "properties": {
          "collection": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "excerpt": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "runbook_frontmatter_suggestion": {
      "type": "object",
      "required": [
        "id",
        "title",
        "tags",
        "status",
        "replicated_by",
        "sandbox_ref",
        "created",
        "last_verified",
        "constella"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "replicated_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sandbox_ref": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "last_verified": {
          "type": "string"
        },
        "constella": {
          "type": "boolean"
        }
      }
    },
    "future_stacking": {
      "type": "object",
      "properties": {
        "suggested_prereq_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_next_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learning_objective_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "required_fields_ok",
        "source_evidence_non_empty",
        "step_count_ok"
      ],
      "properties": {
        "required_fields_ok": {
          "type": "boolean"
        },
        "source_evidence_non_empty": {
          "type": "boolean"
        },
        "step_count_ok": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
